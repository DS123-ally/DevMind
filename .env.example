# Local Neo4j from docker-compose.yml, or Aura (neo4j+s://....databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devmindlocal
NEO4J_DATABASE=neo4j

# LLM provider: openrouter | groq | openai | graphacademy
DEVMIND_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional extra browser origins when the UI is not served from this process
DEVMIND_CORS_ORIGINS=

# Optional Jira Cloud tickets (Atlassian email + API token from id.atlassian.com)
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT=PROJ

# Optional OpenAI-compatible model (OpenRouter, Groq, Ollama)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

