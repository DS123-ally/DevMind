# Local Neo4j from docker-compose.yml, or Aura (neo4j+s://....databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devmindlocal
NEO4J_DATABASE=neo4j

# Optional. When unset, briefings are written directly from graph facts.
# Any OpenAI-compatible API works, including Ollama:
# DEVMIND_LLM_BASE_URL=http://localhost:11434/v1
# DEVMIND_LLM_API_KEY=ollama
# DEVMIND_LLM_MODEL=llama3.1
DEVMIND_LLM_BASE_URL=
DEVMIND_LLM_API_KEY=
DEVMIND_LLM_MODEL=

DEVMIND_HOST=127.0.0.1
DEVMIND_PORT=8000
