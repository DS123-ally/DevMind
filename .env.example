# Local Neo4j from docker-compose.yml, or Aura (neo4j+s://....databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devmindlocal
NEO4J_DATABASE=neo4j

# Optional. GraphAcademy / OpenAI-compatible APIs:
# OPENAI_API_KEY=ga-...
# OPENAI_BASE_URL=https://graphacademy.neo4j.com/api/llm/v1
# OPENAI_MODEL=gpt-4o-mini
DEVMIND_LLM_BASE_URL=
DEVMIND_LLM_API_KEY=
DEVMIND_LLM_MODEL=

DEVMIND_HOST=127.0.0.1
DEVMIND_PORT=8000

# Optional GitHub (private repos and higher rate limits)
GITHUB_TOKEN=

# Optional OpenAI-compatible model (OpenRouter, Groq, Ollama)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

